# =============================================================================
# rag-vs-agentic — environment template
# Copy to .env and fill in. .env is gitignored; this template is committed.
# =============================================================================

# --- Azure OpenAI LLM (GPT-5 family) -----------------------------------------
AZURE_OPENAI_LLM_BASE_URL=
AZURE_OPENAI_LLM_API_KEY=
AZURE_OPENAI_LLM_DEPLOYMENT=
AZURE_OPENAI_LLM_API_VERSION=2025-04-01-preview
LLM_MAX_COMPLETION_TOKENS=8192
LLM_TEMPERATURE=1.0

# --- Azure OpenAI Embedding --------------------------------------------------
AZURE_OPENAI_EMBEDDING_BASE_URL=
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_API_VERSION=2025-04-01-preview
AZURE_OPENAI_EMBEDDING_DIMENSION=

# --- Azure Reranker ----------------------------------------------------------
AZURE_RERANKER_BASE_URL=
AZURE_RERANKER_API_KEY=
AZURE_RERANKER_DEPLOYMENT=

# --- Local models ------------------------------------------------------------
LOCAL_EMBEDDING_MODEL_PATH=/path/to/multilingual-e5-small
LOCAL_RERANKER_MODEL_PATH=/path/to/bge-reranker-v2-m3

# --- Data --------------------------------------------------------------------
DATA_PATH=/path/to/requirements.jsonl

# --- ChromaDB ----------------------------------------------------------------
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION_LOCAL=docs-local-e5
CHROMA_COLLECTION_AZURE=docs-azure
